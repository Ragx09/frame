# Frontend build-time environment (Vercel → Project → Environment Variables).
#
# The ONLY variable the frontend needs. Everything else — including which
# Supabase project to use — is served at runtime from the backend's /api/meta,
# so no key is ever baked into the bundle.
#
# Set this to the deployed BACKEND origin, with no trailing slash and no /api.
VITE_API_URL=https://frame-api.up.railway.app
