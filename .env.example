# FRAME Beta — environment.
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# Local development needs NONE of this: with an empty file FRAME runs exactly
# as it always has — SQLite on disk, no sign-in, structural AI.

# ---------------------------------------------------------------- hosted AI
# The developer's OpenRouter key. SERVER ONLY — never sent to the browser.
# Leave blank to run without hosted AI; FRAME falls back to the structural
# provider and everything except the model-backed features still works.
OPENROUTER_API_KEY=

# The hosted model. Changed here, never in code.
OPENROUTER_MODEL=anthropic/claude-opus-5

# Used for a beta user's own Anthropic key (BYOK), and for a developer key
# in local development.
ANTHROPIC_MODEL=claude-opus-5

# A developer's own Anthropic key for local work only. Not used in cloud mode.
ANTHROPIC_API_KEY=

# --------------------------------------------------------------------- beta
# Hosted AI requests allowed per user per UTC day. 0 disables the limit.
# BYOK requests and structural results never count against this.
BETA_DAILY_AI_LIMIT=20

# Hosted AI requests allowed per user per minute, as abuse prevention.
AI_RATE_LIMIT_PER_MINUTE=12

# Optional. A link (Tally, Google Form, GitHub issues…) for beta feedback.
# Leave blank and FRAME stores feedback in its own table instead.
PUBLIC_FEEDBACK_URL=

# ----------------------------------------------------------------- supabase
# All three must be set together to turn on cloud mode. With any of them
# missing FRAME stays in local SQLite mode.
#
# Settings -> API in the Supabase dashboard.
SUPABASE_URL=
# Publishable ("anon") key — safe in the browser, constrained by RLS.
SUPABASE_PUBLISHABLE_KEY=
# Secret ("service_role") key — BYPASSES RLS. Server only. Never expose.
SUPABASE_SECRET_KEY=
# Settings -> Database -> Connection string -> URI. Use the pooled (port 6543)
# connection string on serverless hosts; the direct one (5432) elsewhere.
DATABASE_URL=

# ---------------------------------------------------------------------- app
# Public origin of the deployed FRONTEND. Drives CORS and auth redirects.
# No trailing slash. e.g. https://frame.vercel.app
APP_URL=

NODE_ENV=production
PORT=8787
